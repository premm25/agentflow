# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Any OpenAI-compatible gateway (LiteLLM, vLLM, OpenAI, ...). The harness manifest (harness/manifest.json)
# names the model per role; change it there if your gateway uses different model names.
ROA_LLM_BASE_URL=http://localhost:4000/v1
ROA_LLM_API_KEY=replace-me

# Optional overrides (defaults shown)
# ROA_PORT=8100
# ROA_OTLP_ENDPOINT=http://localhost:8200/v1/traces
# ROA_DASHBOARD_URL=http://localhost:8200
# ROA_OTEL_ENABLED=true
# ROA_LOG_LEVEL=INFO
# DASHBOARD_PORT=8200
# ORCHESTRATOR_URL=http://localhost:8100

# Docker Compose only (docker compose up --build)
# Address a browser uses to reach this machine; set to the LAN IP or hostname to share on a network.
# PUBLIC_HOST=localhost
# When the gateway runs on the host machine, use host.docker.internal in ROA_LLM_BASE_URL, e.g.
# ROA_LLM_BASE_URL=http://host.docker.internal:4000/v1
